# Gemini API key for the Giya AI chat.
# Get one at https://aistudio.google.com/apikey
#
# Expo only inlines vars prefixed with EXPO_PUBLIC_ into the client bundle,
# so the app reads process.env.EXPO_PUBLIC_GEMINI_API_KEY at runtime.
# Copy this file to .env.local and fill in your key (.env*.local is gitignored).
EXPO_PUBLIC_GEMINI_API_KEY="your-key-here"
